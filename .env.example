# THREATPULSE: Cyber Threat & Stock Market Intelligence Platform
# Environment Configuration Template
# Copy this file to .env and configure with your credentials

# Google Gemini API Key for AI-assisted cyber threat analysis
# If not provided, the platform automatically uses a rule-based heuristic fallback
GEMINI_API_KEY=

# Discord Webhook URL for real-time critical breach alerts
# Optional: leaving this blank disables Discord notifications
DISCORD_WEBHOOK_URL=
